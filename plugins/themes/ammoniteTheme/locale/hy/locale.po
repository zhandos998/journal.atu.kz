msgid "plugins.themes.ammonite.name"
msgstr "Ammonite թեմա"

msgid "plugins.themes.ammonite.description"
msgstr "OJS թեմա, որը նախագծված է Դանիայի և Գրենլանդիայի Երկրաբանական ծառայության համար, հիմնված է Health Sciences թեմայի վրա։ Պահանջում է Health Sciences թեմայի տեղադրում, հակառակ դեպքում այս թեման չի բեռնի իր ոճերը, ձևանմուշները կամ hook-երը։"

